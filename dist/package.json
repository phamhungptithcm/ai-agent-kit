{
  "name": "@hunpeolabs/ai-agent-kit",
  "version": "0.1.0",
  "description": "Bootstrap a repository-scoped AI agent operating system for Claude Code and Codex with CodeGraph and CocoIndex safety gates.",
  "type": "module",
  "bin": {
    "ai-agent-kit": "./bin/ai-agent-kit.mjs"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "agent-os",
    "codex",
    "claude-code",
    "codegraph",
    "cocoindex",
    "repository-intelligence",
    "developer-productivity",
    "qa-automation",
    "code-review",
    "bootstrap"
  ],
  "homepage": "https://github.com/phamhungptithcm/ai-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/phamhungptithcm/ai-agent-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamhungptithcm/ai-agent-kit.git"
  },
  "files": [
    "assets/",
    "bin/",
    "docs/",
    "src/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "package.json"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "release:dry-run": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
