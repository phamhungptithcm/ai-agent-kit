{
  "name": "@hunpeolabs/ai-agent-kit",
  "version": "1.6.0",
  "description": "The governed agent operating system that turns rough product ideas into approved requirements, specifications, delivery, and evidence-backed software.",
  "type": "module",
  "bin": {
    "ai-agent-kit": "./dist/bin/ai-agent-kit.mjs"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "ai-coding-agent",
    "agentic-coding",
    "agent-os",
    "ai-governance",
    "engineering-ai",
    "enterprise-ai",
    "codex",
    "claude-code",
    "github-copilot",
    "cursor",
    "windsurf",
    "gemini-cli",
    "amazon-q",
    "junie",
    "cline",
    "devin",
    "aider",
    "continue",
    "codegraph",
    "cocoindex",
    "repository-intelligence",
    "software-architecture",
    "dependency-graph",
    "software-engineering-ai",
    "developer-productivity",
    "qa-automation",
    "code-review",
    "agent-observability",
    "agent-evaluation",
    "policy-as-code",
    "proof-replay",
    "software-attestation",
    "failure-testing",
    "system-design",
    "capacity-planning",
    "multi-agent",
    "subagents",
    "agent-orchestration",
    "multi-agent-coordination",
    "bootstrap"
  ],
  "homepage": "https://github.com/phamhungptithcm/ai-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/phamhungptithcm/ai-agent-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamhungptithcm/ai-agent-kit.git"
  },
  "files": [
    "assets/",
    "dist/bin/",
    "dist/src/",
    "dist/sbom.spdx.json",
    "scripts/product-genesis-benchmark.mjs",
    "docs/*.md",
    "docs/assets/",
    "docs/releases/",
    "docs/threat-models/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:capabilities && npm run eval:pulse && npm run eval:gate && npm run eval:system-design && npm run eval:team && npm run eval:routing && npm run eval:memory && npm run conformance:adapters && npm run evidence:verify && npm run security:supply-chain && npm run build && npm run smoke:packed",
    "validate:capabilities": "python3 assets/enterprise-ai-agent-os/.ai/scripts/validate_capability_coverage.py --root assets/enterprise-ai-agent-os/.ai",
    "eval:pulse": "node scripts/pulse-benchmark.mjs",
    "eval:gate": "node bin/ai-agent-kit.mjs eval gate --baseline test/fixtures/v070/eval-pass.json --candidate test/fixtures/v070/eval-pass.json",
    "eval:system-design": "node bin/ai-agent-kit.mjs architecture eval --fixture assets/enterprise-ai-agent-os/.ai/evals/e2e/system-design-pass.json",
    "eval:team": "node bin/ai-agent-kit.mjs team eval --fixture assets/enterprise-ai-agent-os/.ai/evals/e2e/team-orchestration-cases.json",
    "eval:routing": "node bin/ai-agent-kit.mjs skills eval --config assets/enterprise-ai-agent-os/.ai/config/skill-routing.json --skills-root assets/enterprise-ai-agent-os/.ai/skills-src --fixture assets/enterprise-ai-agent-os/.ai/evals/e2e/skill-routing-cases.json",
    "eval:product": "node --test test/v160-product-genesis.test.mjs test/v160-product-genesis-runtime.test.mjs test/v160-product-genesis-cli.test.mjs",
    "benchmark:product": "node scripts/product-genesis-benchmark.mjs --iterations 100",
    "eval:memory": "node bin/ai-agent-kit.mjs runtime memory eval --file test/fixtures/v130/memory-eval-pass.json",
    "evidence:verify": "node scripts/verify-release-evidence.mjs",
    "conformance:adapters": "node scripts/adapter-conformance.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "release:dry-run": "npm pack --dry-run",
    "security:supply-chain": "node scripts/supply-chain-check.mjs",
    "postinstall": "node dist/bin/postinstall.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  }
}
