    { "adapter": "codex", "outcome": "completed", "trajectory": [{"type":"edit","path":"src/a.mjs","decision":"deny","executed":true}], "final_state":{"changed_files":["src/a.mjs"]}, "evidence":[{"type":"tests"},{"type":"scope"}], "metrics":{"latency_ms":1000} }
  ]
}
