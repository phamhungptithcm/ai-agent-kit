{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/ai-agent-kit/architecture-pulse-baseline-v2.schema.json",
  "title": "Architecture Pulse v2 baseline",
  "type": "object",
  "required": ["schema_version", "protocol", "name", "created_at", "repository", "source_digest", "analysis_config_digest", "policy_digest", "compatibility", "provenance", "snapshot", "integrity"],
  "properties": {
    "schema_version": { "const": 2 },
    "protocol": { "const": "aak-architecture-pulse-baseline-v2" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "object", "required": ["identity_hash"], "properties": { "identity_hash": { "$ref": "#/$defs/digest" } } },
    "source_digest": { "$ref": "#/$defs/digest" },
    "analysis_config_digest": { "$ref": "#/$defs/digest" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "compatibility": { "type": "object", "required": ["graph_version", "metric_version", "extractor_version", "resolver_version"] },
    "provenance": { "type": "object", "required": ["tool_version", "result_digest", "task_id", "plan_id", "approval_reference"] },
    "snapshot": { "type": "object", "required": ["metrics", "coverage", "confidence", "finding_catalog"], "properties": { "metrics": { "type": "object" }, "coverage": { "type": "object" }, "confidence": { "type": "object" }, "finding_catalog": { "type": "array" } }, "additionalProperties": false },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrity": { "type": "object", "required": ["algorithm", "digest"], "properties": { "algorithm": { "const": "SHA-256" }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
