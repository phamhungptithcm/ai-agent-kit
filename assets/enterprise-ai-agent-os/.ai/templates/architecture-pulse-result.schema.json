{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/ai-agent-kit/architecture-pulse-result-v2.schema.json",
  "title": "Architecture Pulse v2 result",
  "type": "object",
  "required": ["schema_version", "protocol", "tool_version", "graph_version", "metric_version", "extractor_version", "resolver_version", "analysis_status", "reason_codes", "repository", "governance", "inventory", "graph", "findings", "finding_catalog", "metrics", "coverage", "confidence", "cache", "diagnostic_notice", "result_digest"],
  "properties": {
    "schema_version": { "const": 2 },
    "protocol": { "const": "aak-architecture-pulse-v2" },
    "tool_version": { "type": "string", "minLength": 1 },
    "graph_version": { "type": "string", "minLength": 1 },
    "metric_version": { "type": "string", "minLength": 1 },
    "extractor_version": { "type": "string", "minLength": 1 },
    "resolver_version": { "type": "string", "minLength": 1 },
    "analysis_status": { "enum": ["COMPLETE", "DEGRADED"] },
    "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "repository": { "type": "object", "required": ["available", "identity_hash", "dirty", "worktree_digest"], "properties": { "available": { "type": "boolean" }, "identity_hash": { "$ref": "#/$defs/digest" }, "commit": { "type": ["string", "null"] }, "branch": { "type": ["string", "null"] }, "dirty": { "type": "boolean" }, "worktree_digest": { "$ref": "#/$defs/digest" } } },
    "governance": { "type": "object", "required": ["task_id", "plan_id", "approval_reference"], "properties": { "task_id": { "type": ["string", "null"] }, "plan_id": { "type": ["string", "null"] }, "approval_reference": { "type": ["string", "null"] } }, "additionalProperties": false },
    "inventory": { "type": "object", "required": ["source_digest", "analysis_config_digest", "policy_digest", "counts", "limits", "status"], "properties": { "source_digest": { "$ref": "#/$defs/digest" }, "analysis_config_digest": { "$ref": "#/$defs/digest" }, "policy_digest": { "$ref": "#/$defs/digest" }, "counts": { "type": "object" }, "limits": { "type": "object" }, "status": { "enum": ["COMPLETE", "DEGRADED"] } } },
    "graph": { "type": "object", "required": ["storage", "graph_digest"], "properties": { "storage": { "enum": ["inline", "external"] }, "graph_digest": { "$ref": "#/$defs/digest" }, "nodes": { "type": "array" }, "edges": { "type": "array" }, "unresolved": { "type": "array" }, "extraction_failures": { "type": "array" }, "artifacts": { "type": "array" } } },
    "findings": { "type": "object" },
    "finding_catalog": { "type": "array", "items": { "type": "object", "required": ["type", "fingerprint", "identity", "title", "evidence_tier"], "properties": { "fingerprint": { "type": "string" }, "type": { "type": "string" }, "identity": { "type": "object" }, "title": { "type": "string" }, "evidence_tier": { "$ref": "#/$defs/tier" } } } },
    "metrics": { "type": "object" },
    "coverage": { "type": "object", "required": ["files", "supported_scope", "imports", "parse", "supported_in_scope", "unsupported_in_scope", "excluded_by_policy", "external_declared", "unresolved_internal", "ambiguous", "parse_failed"] },
    "confidence": { "type": "object", "required": ["score", "band", "minimum_evidence_tier"], "properties": { "score": { "$ref": "#/$defs/ratio" }, "band": { "enum": ["LOW", "MEDIUM", "HIGH"] }, "minimum_evidence_tier": { "$ref": "#/$defs/tier" } } },
    "cache": { "type": "object", "required": ["authoritative", "used"], "properties": { "authoritative": { "const": false }, "used": { "type": "boolean" } }, "additionalProperties": false },
    "diagnostic_notice": { "type": "string", "minLength": 1 },
    "result_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tier": { "enum": ["SOURCE_FALLBACK", "AST_VERIFIED", "RESOLVER_VERIFIED", "INDEX_VERIFIED", "EXPLICIT_MANIFEST"] }
  },
  "additionalProperties": false
}
