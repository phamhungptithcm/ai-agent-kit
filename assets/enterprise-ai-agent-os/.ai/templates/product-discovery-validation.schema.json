{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunpeolabs.com/schemas/product-discovery-validation-v1.json", "title": "Product Discovery Validation", "type": "object",
  "required": ["schema_version", "id", "version", "status", "source_versions", "hypotheses", "experiments", "prototypes", "usability_tests", "customer_evidence", "decision"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "status": {"type": "string"}, "source_versions": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}, "experiments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}, "prototypes": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "usability_tests": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "customer_evidence": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "decision": {"type": "object", "required": ["recommendation", "rationale", "evidence_receipt_ids"], "properties": {"recommendation": {"enum": ["CONTINUE", "PIVOT", "STOP"]}, "rationale": {"type": "string"}, "evidence_receipt_ids": {"$ref": "#/$defs/evidence"}}}},
  "$defs": {"evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "item": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "evidence_receipt_ids": {"$ref": "#/$defs/evidence"}}}}
}
