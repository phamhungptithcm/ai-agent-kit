{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Versioned team context","type":"object","required":["schema_version","task_id","state","revision","knowledge_revision","brief","assignments","claims","handoffs","conflicts","decisions","context_hash"],"properties":{"schema_version":{"const":1},"task_id":{"type":"string"},"state":{"enum":["PLANNED","ACTIVE"]},"revision":{"type":"integer","minimum":1},"knowledge_revision":{"type":"integer","minimum":0},"brief":{"type":"object"},"assignments":{"type":"array","minItems":2,"maxItems":6},"claims":{"type":"array","maxItems":200},"handoffs":{"type":"array","maxItems":100},"conflicts":{"type":"array","maxItems":100},"decisions":{"type":"array","maxItems":100},"context_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":true}
