{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunpeolabs.com/schemas/product-environment-attestation-v1.json", "title": "Product Environment Attestation", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "name", "environment_class", "trust_level", "repository_commit", "declared_by", "declared_at", "expires_at", "evidence_receipt_ids"],
  "properties": {"schema_version": {"const": 1}, "id": {"type": "string"}, "name": {"type": "string"}, "environment_class": {"enum": ["LOCAL", "SYNTHETIC", "STAGING", "PILOT", "PRODUCTION"]}, "trust_level": {"enum": ["REPOSITORY_BOUND", "PROVIDER_VERIFIED", "SIGNED_ATTESTATION"]}, "repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "declared_by": {"type": "string"}, "declared_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "provider": {"type": ["object", "null"]}, "evidence_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}, "attestation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
