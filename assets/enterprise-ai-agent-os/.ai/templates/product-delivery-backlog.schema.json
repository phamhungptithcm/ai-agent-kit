{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-delivery-backlog-v1.json",
  "title": "Product Delivery Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approved_baselines", "mvp_outcome", "milestones", "items", "definition_of_ready", "definition_of_done"],
  "properties": {
    "schema_version": {"const": 1}, "approved_baselines": {"type": "array", "minItems": 2, "items": {"type": "object"}}, "mvp_outcome": {"type": "string", "minLength": 1}, "milestones": {"type": "array", "items": {"type": "object"}},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "outcome", "requirement_ids", "acceptance_ids", "dependencies", "estimate", "risk", "assurance"], "properties": {"id": {"type": "string"}, "type": {"enum": ["EPIC", "STORY", "ENABLER", "SPIKE", "TEST", "OPERATION"]}, "title": {"type": "string"}, "outcome": {"type": "string"}, "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptance_ids": {"type": "array", "items": {"type": "string"}}, "dependencies": {"type": "array", "items": {"type": "string"}}, "estimate": {"type": "object", "required": ["low", "high", "unit", "confidence"], "properties": {"low": {"type": "number", "minimum": 0}, "high": {"type": "number", "minimum": 0}, "unit": {"type": "string"}, "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}}, "additionalProperties": false}, "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "assurance": {"type": "array", "items": {"type": "string"}}}}},
    "definition_of_ready": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
