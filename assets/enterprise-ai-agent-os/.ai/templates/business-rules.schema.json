{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/business-rules-v1.json",
  "title": "Business Rule Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "source_versions", "rules"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]},
    "source_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "condition", "outcome", "owner", "source_requirement_ids", "examples", "exceptions"], "properties": {"id": {"type": "string", "pattern": "^RULE-[0-9]{3,}$"}, "name": {"type": "string", "minLength": 1}, "condition": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "source_requirement_ids": {"type": "array", "items": {"type": "string"}}, "examples": {"type": "array", "items": {"type": "string"}}, "exceptions": {"type": "array", "items": {"type": "string"}}}}},
    "recorded_at": {"type": "string", "format": "date-time"}, "parent_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
