{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Structured team handoff","type":"object","required":["assignment_id","agent_id","claim_id","brief_hash","context_revision","facts","findings","decisions_needed","risks","unresolved_questions","affected_paths","tests_recommended","evidence","status","published_at","handoff_hash"],"properties":{"assignment_id":{"type":"string"},"agent_id":{"type":"string"},"claim_id":{"type":"string"},"brief_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"context_revision":{"type":"integer","minimum":0},"facts":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"findings":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"decisions_needed":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"risks":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"unresolved_questions":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"affected_paths":{"type":"array","maxItems":100,"items":{"type":"string"}},"tests_recommended":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000}},"evidence":{"type":"array","maxItems":50,"items":{"type":"object","required":["path","line_start","line_end","sha256"],"properties":{"path":{"type":"string"},"line_start":{"type":"integer","minimum":1},"line_end":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},"status":{"enum":["COMPLETED","BLOCKED","REJECTED"]},"published_at":{"type":"string","format":"date-time"},"handoff_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
