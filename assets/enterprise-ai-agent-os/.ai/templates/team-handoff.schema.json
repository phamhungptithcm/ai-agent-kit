{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-handoff-v2",
  "title": "Structured team handoff",
  "type": "object",
  "required": ["assignment_id", "agent_id", "claim_id", "brief_hash", "context_revision", "facts", "findings", "structured_findings", "decisions_needed", "risks", "unresolved_questions", "affected_paths", "tests_recommended", "evidence", "status", "published_at", "handoff_hash"],
  "properties": {
    "assignment_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "brief_hash": { "$ref": "#/$defs/hash" },
    "context_revision": { "type": "integer", "minimum": 0 },
    "facts": { "$ref": "#/$defs/statements" },
    "findings": { "$ref": "#/$defs/statements" },
    "structured_findings": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/finding" } },
    "decisions_needed": { "$ref": "#/$defs/statements" },
    "risks": { "$ref": "#/$defs/statements" },
    "unresolved_questions": { "$ref": "#/$defs/statements" },
    "affected_paths": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
    "tests_recommended": { "$ref": "#/$defs/statements" },
    "evidence": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/evidence" } },
    "status": { "enum": ["COMPLETED", "BLOCKED", "REJECTED"] },
    "published_at": { "type": "string", "format": "date-time" },
    "handoff_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "statements": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 1000 } },
    "finding": {
      "type": "object",
      "required": ["fingerprint", "severity", "confidence", "category", "summary", "path", "line", "recommendation", "evidence_hashes", "specialist"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/hash" },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 1000 },
        "path": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "recommendation": { "type": ["string", "null"], "maxLength": 1000 },
        "evidence_hashes": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/hash" } },
        "specialist": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["path", "line_start", "line_end", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
