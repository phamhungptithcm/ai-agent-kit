{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-research-v1.json",
  "title": "Product Research Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "idea_version", "questions", "evidence", "findings", "limitations", "decision"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "idea_version": {"type": "string"},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "question", "decision_criterion"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "decision_criterion": {"type": "string"}}, "additionalProperties": false}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "retrieved_at", "claim", "confidence", "limitations"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["USER_INTERVIEW", "OBSERVATION", "PRIMARY_SOURCE", "OFFICIAL_DATA", "VENDOR_DOC", "DESK_RESEARCH", "PROTOTYPE", "INFERENCE"]}, "source": {"type": "string"}, "retrieved_at": {"type": "string", "format": "date-time"}, "claim": {"type": "string"}, "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}, "limitations": {"type": "array", "items": {"type": "string"}}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "statement", "evidence_ids"], "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "object", "required": ["recommendation", "rationale"], "properties": {"recommendation": {"enum": ["PROCEED", "PIVOT", "PAUSE", "STOP"]}, "rationale": {"type": "string"}}, "additionalProperties": false}
  }
}
