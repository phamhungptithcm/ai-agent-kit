{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-specification-v1.json",
  "title": "Product Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "approved_brd", "journeys", "functional_requirements", "non_functional_requirements", "acceptance_criteria", "data_and_integrations", "operations", "traceability"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^SPEC-[A-Z0-9-]+$"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]},
    "approved_brd": {"$ref": "#/$defs/baseline"}, "journeys": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "functional_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/specItem"}},
    "non_functional_requirements": {"type": "array", "items": {"$ref": "#/$defs/specItem"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "given", "when", "then", "verifies"], "properties": {"id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"}, "given": {"type": "string"}, "when": {"type": "string"}, "then": {"type": "string"}, "verifies": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "data_and_integrations": {"type": "array", "items": {"type": "object"}}, "operations": {"type": "object"}, "traceability": {"type": "array", "items": {"$ref": "#/$defs/trace"}}
  },
  "$defs": {
    "baseline": {"type": "object", "additionalProperties": false, "required": ["id", "version", "hash"], "properties": {"id": {"type": "string"}, "version": {"type": "integer"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "specItem": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "source_requirement_ids", "verification_ids"], "properties": {"id": {"type": "string", "pattern": "^(FR|NFR)-[0-9]{3,}$"}, "statement": {"type": "string"}, "source_requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "verification_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "trace": {"type": "object", "additionalProperties": false, "required": ["source_id", "target_ids"], "properties": {"source_id": {"type": "string"}, "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
