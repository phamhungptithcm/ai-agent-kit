{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-outcome-v1.json",
  "title": "Product Outcome Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "environment", "metrics", "evidence", "recommendation", "rationale"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]}, "environment": {"enum": ["PILOT", "PRODUCTION"]},
    "metrics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "target", "actual", "window", "source"], "properties": {"id": {"type": "string"}, "target": {}, "actual": {}, "window": {"type": "string"}, "source": {"type": "string"}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "recommendation": {"enum": ["RELEASE", "LIMITED_RELEASE", "HOLD", "ROLLBACK", "ITERATE", "RETIRE"]}, "rationale": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string"}},
    "recorded_at": {"type": "string", "format": "date-time"}, "parent_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
