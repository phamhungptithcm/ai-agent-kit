{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-benchmark-v1",
  "title": "Comparable three-mode Agent Department benchmark",
  "type": "object",
  "required": ["schema_version", "synthetic", "methodology", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "synthetic": { "type": "boolean" },
    "methodology": {
      "type": "object",
      "required": ["same_task", "same_repository_commit", "same_host", "same_model"],
      "properties": {
        "same_task": { "const": true },
        "same_repository_commit": { "const": true },
        "same_host": { "const": true },
        "same_model": { "const": true },
        "repetitions_per_mode": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repository_commit", "host", "model", "runs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "repository_commit": { "type": "string", "minLength": 7 },
          "host": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["mode", "status", "escaped_defects", "scope_violations", "duplicate_scans", "tokens", "duration_seconds", "review_cycles", "evidence_items", "required_evidence_items"],
              "properties": {
                "mode": { "enum": ["SINGLE_AGENT", "UNGOVERNED_MULTI_AGENT", "AGENT_DEPARTMENT"] },
                "status": { "enum": ["COMPLETED", "FAILED", "BLOCKED"] },
                "escaped_defects": { "type": "number", "minimum": 0 },
                "scope_violations": { "type": "number", "minimum": 0 },
                "duplicate_scans": { "type": "number", "minimum": 0 },
                "tokens": { "type": "number", "minimum": 0 },
                "duration_seconds": { "type": "number", "minimum": 0 },
                "review_cycles": { "type": "number", "minimum": 0 },
                "evidence_items": { "type": "number", "minimum": 0 },
                "required_evidence_items": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
