{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-benchmark-v3",
  "title": "Signed four-mode repository control-plane benchmark",
  "type": "object",
  "required": ["schema_version", "profile", "methodology", "cases"],
  "properties": {
    "schema_version": { "const": 3 },
    "profile": { "const": "V1_5_RELEASE" },
    "methodology": {
      "type": "object",
      "required": ["repetitions_per_mode", "minimum_task_cases"],
      "properties": {
        "repetitions_per_mode": { "type": "integer", "minimum": 3, "maximum": 100 },
        "minimum_task_cases": { "type": "integer", "minimum": 30, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "repository_commit", "host", "model", "runs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "repository_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
          "host": { "type": "string", "minLength": 1, "maxLength": 256 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "runs": {
            "type": "array",
            "minItems": 12,
            "items": {
              "type": "object",
              "required": ["mode", "status", "escaped_defects", "scope_violations", "duplicate_scans", "tokens", "duration_seconds", "review_cycles", "evidence_items", "required_evidence_items", "receipt"],
              "properties": {
                "mode": { "enum": ["SINGLE_AGENT", "UNGOVERNED_MULTI_AGENT", "TASK_LOCAL_GOVERNED", "REPOSITORY_CONTROL_PLANE"] },
                "status": { "enum": ["COMPLETED", "FAILED", "BLOCKED"] },
                "escaped_defects": { "type": "number", "minimum": 0 },
                "scope_violations": { "type": "number", "minimum": 0 },
                "duplicate_scans": { "type": "number", "minimum": 0 },
                "tokens": { "type": "number", "minimum": 0 },
                "duration_seconds": { "type": "number", "minimum": 0 },
                "review_cycles": { "type": "number", "minimum": 0 },
                "evidence_items": { "type": "number", "minimum": 0 },
                "required_evidence_items": { "type": "number", "minimum": 0 },
                "receipt": {
                  "type": "object",
                  "required": ["schema_version", "run_id", "case_id", "mode", "repository_commit", "host", "model", "environment", "run_hash", "key_id", "recorded_at", "signature"],
                  "properties": {
                    "schema_version": { "const": 1 },
                    "run_id": { "type": "string" },
                    "case_id": { "type": "string" },
                    "mode": { "type": "string" },
                    "repository_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
                    "host": { "type": "string" },
                    "model": { "type": "string" },
                    "environment": { "enum": ["RUNTIME", "SYNTHETIC"] },
                    "run_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "key_id": { "type": "string" },
                    "recorded_at": { "type": "string", "format": "date-time" },
                    "signature": { "type": "string", "minLength": 80, "maxLength": 100 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
