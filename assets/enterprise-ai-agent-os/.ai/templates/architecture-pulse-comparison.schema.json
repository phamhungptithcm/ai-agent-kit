{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/ai-agent-kit/architecture-pulse-comparison-v2.schema.json",
  "title": "Architecture Pulse v2 comparison",
  "type": "object",
  "required": ["schema_version", "protocol", "status", "reason_code", "reason", "blocking", "findings", "finding_changes", "waivers", "baseline", "governance", "current", "evidence_digest"],
  "properties": {
    "schema_version": { "const": 2 },
    "protocol": { "const": "aak-architecture-pulse-comparison-v2" },
    "status": { "enum": ["IMPROVED", "STABLE", "REGRESSED", "STALE", "UNTRUSTED", "DEGRADED"] },
    "reason_code": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "findings": { "type": "array" },
    "finding_changes": { "type": "object", "required": ["new", "unchanged", "updated", "fixed"], "properties": { "new": { "type": "array" }, "unchanged": { "type": "array" }, "updated": { "type": "array" }, "fixed": { "type": "array" } }, "additionalProperties": false },
    "waivers": { "type": "object" },
    "baseline_digest": { "$ref": "#/$defs/nullableDigest" },
    "current_result_digest": { "$ref": "#/$defs/nullableDigest" },
    "baseline": { "type": "string", "minLength": 1 },
    "governance": { "type": "object" },
    "current": { "type": "object", "required": ["result_digest", "source_digest", "analysis_config_digest", "policy_digest", "repository", "metrics", "coverage", "confidence"] },
    "evidence_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
