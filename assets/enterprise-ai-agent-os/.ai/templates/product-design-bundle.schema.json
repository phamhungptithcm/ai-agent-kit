{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-design-bundle-v1.json",
  "title": "Product Design Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "risk_profile", "approved_brd", "specification", "tracks", "decisions", "risks"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]}, "risk_profile": {"enum": ["LEAN", "STANDARD", "HIGH_ASSURANCE"]},
    "approved_brd": {"$ref": "#/$defs/baseline"}, "specification": {"$ref": "#/$defs/baseline"},
    "tracks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "summary", "rationale", "artifacts", "requirement_ids", "risks"], "properties": {"id": {"enum": ["ux", "domain", "data", "architecture", "security", "privacy", "compliance", "capacity", "operations", "test", "rollout", "disaster_recovery"]}, "status": {"enum": ["READY", "NOT_APPLICABLE", "BLOCKED"]}, "summary": {"type": "string"}, "rationale": {"type": "string"}, "artifacts": {"type": "array", "items": {"type": "string"}}, "requirement_ids": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}}}},
    "decisions": {"type": "array", "items": {"type": "object"}}, "risks": {"type": "array", "items": {"type": "object"}},
    "recorded_at": {"type": "string", "format": "date-time"}, "parent_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"baseline": {"type": "object", "additionalProperties": false, "required": ["id", "version", "hash"], "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
