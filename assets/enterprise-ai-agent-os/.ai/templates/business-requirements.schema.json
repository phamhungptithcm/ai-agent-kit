{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/business-requirements-v1.json",
  "title": "Business Requirements Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "source_versions", "problem", "stakeholders", "goals", "scope", "non_goals", "requirements", "risks", "decisions"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^BRD-[A-Z0-9-]+$"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]},
    "source_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "problem": {"type": "string", "minLength": 1},
    "stakeholders": {"type": "array", "items": {"type": "object", "required": ["role", "decision_rights"], "properties": {"role": {"type": "string"}, "decision_rights": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "goals": {"type": "array", "items": {"type": "object", "required": ["id", "outcome", "metric", "target", "window", "owner"], "properties": {"id": {"type": "string"}, "outcome": {"type": "string"}, "metric": {"type": "string"}, "baseline": {}, "target": {}, "window": {"type": "string"}, "owner": {"type": "string"}}, "additionalProperties": false}},
    "scope": {"type": "array", "items": {"type": "string"}}, "non_goals": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}, "risks": {"type": "array", "items": {"type": "string"}}, "decisions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"requirement": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "rationale", "priority", "status", "source_ids", "acceptance_method", "owner"], "properties": {"id": {"type": "string", "pattern": "^BR-[0-9]{3,}$"}, "statement": {"type": "string", "minLength": 1}, "rationale": {"type": "string"}, "priority": {"enum": ["MUST", "SHOULD", "COULD", "WONT_NOW"]}, "status": {"enum": ["DRAFT", "PROPOSED", "APPROVED", "CHANGED", "RETIRED"]}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptance_method": {"type": "string"}, "owner": {"type": "string"}}}}
}
