{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.dev/schemas/plugin-manifest.v1.json",
  "title": "AI Agent Kit Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "publisher", "surfaces", "permissions", "hosts", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "publisher": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["skills", "rules", "profiles", "hooks", "commands", "adapters", "templates", "schemas", "ui"] } },
    "permissions": { "type": "object" },
    "hosts": { "type": "object", "minProperties": 1, "additionalProperties": { "enum": ["native", "generated", "bridged", "advisory", "preview", "unsupported"] } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object", "required": ["source", "commit", "checksum", "signature", "key_id", "public_key_pem", "sbom"] }
  }
}
