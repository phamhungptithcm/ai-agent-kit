{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-verification-v1.json",
  "title": "Product Release Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "approved_delivery", "environment", "acceptance_status", "security_status", "operational_status", "rollback_status", "evidence"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "READY_FOR_APPROVAL", "APPROVED", "CHANGES_REQUESTED", "REJECTED", "SUPERSEDED"]},
    "approved_delivery": {"$ref": "#/$defs/baseline"}, "environment": {"enum": ["LOCAL", "SYNTHETIC", "STAGING", "PILOT", "PRODUCTION"]},
    "acceptance_status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]}, "security_status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]}, "operational_status": {"enum": ["READY", "NOT_READY", "NOT_RUN"]}, "rollback_status": {"enum": ["READY", "NOT_READY", "NOT_RUN"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "environment", "status", "ref", "collected_at"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["ACCEPTANCE", "SECURITY", "OPERATIONS", "ROLLBACK", "PERFORMANCE", "RELIABILITY", "ACCESSIBILITY", "PRIVACY", "LEGAL"]}, "environment": {"enum": ["LOCAL", "SYNTHETIC", "STAGING", "PILOT", "PRODUCTION"]}, "status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]}, "ref": {"type": "string"}, "collected_at": {"type": "string", "format": "date-time"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}, "recorded_at": {"type": "string", "format": "date-time"}, "parent_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"baseline": {"type": "object", "additionalProperties": false, "required": ["id", "version", "hash"], "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
