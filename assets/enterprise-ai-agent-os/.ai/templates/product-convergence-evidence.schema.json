{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunpeolabs.com/schemas/product-convergence-evidence-v1.json",
  "title": "Product Convergence Evidence Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_commit", "baseline_hashes", "items"],
  "properties": {
    "schema_version": {"const": 1}, "implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "baseline_hashes": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/hash"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "status", "task_ids", "code_refs", "test_refs", "evidence_refs"], "properties": {"requirement_id": {"type": "string"}, "status": {"enum": ["VERIFIED", "FAILED", "NOT_RUN", "NOT_APPLICABLE"]}, "task_ids": {"type": "array", "items": {"type": "string"}}, "code_refs": {"type": "array", "items": {"type": "string"}}, "test_refs": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"}}, "rationale": {"type": "string"}}}}
}
