{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phamhungptithcm/ai-agent-kit/schemas/eval-case-v1.json",
  "title": "Replayable agent evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task", "expected", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "repository_fixture": { "type": "object" },
    "task": {
      "type": "object",
      "required": ["goal", "allowed_paths"],
      "properties": {
        "goal": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "allowed_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budgets": { "type": "object" },
    "expected": { "type": "object" },
    "human_rubric": { "type": "array", "items": { "type": "object" } },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapter", "outcome", "trajectory"],
        "properties": {
          "adapter": { "enum": ["claude", "codex"] },
          "model": { "type": "string" },
          "policy_revision": { "type": "string" },
          "outcome": { "type": "string" },
          "trajectory": { "type": "array", "items": { "type": "object" } },
          "final_state": { "type": "object" },
          "evidence": { "type": "array", "items": { "type": "object" } },
          "metrics": { "type": "object" }
        }
      }
    }
  }
}
