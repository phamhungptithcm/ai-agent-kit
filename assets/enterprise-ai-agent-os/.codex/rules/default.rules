# Codex command execution policy for repository-local AI agent work.
# Rules control commands outside the sandbox; they do not replace sandboxing,
# approvals, CI, code review, or production access controls.

prefix_rule(
    pattern = [["codegraph", "ccc"], ["status", "query", "files", "context", "callers", "callees", "impact", "affected", "search", "grep", "doctor"]],
    decision = "allow",
    justification = "Read-only repository intelligence queries are required before planning, review, QA, documentation analysis, and implementation.",
    match = [
        "codegraph status .",
        "codegraph query --path . Account",
        "ccc status",
        "ccc search account balance",
    ],
    not_match = [
        "codegraph init",
        "ccc index",
    ],
)

prefix_rule(
    pattern = [["codegraph", "ccc", "uv"], ["init", "index", "sync", "tool"]],
    decision = "prompt",
    justification = "Repository intelligence setup or refresh mutates local indexes or user-local tooling but must not modify application code.",
    match = [
        "codegraph init .",
        "codegraph sync . --quiet",
        "ccc index",
        "uv tool install --upgrade cocoindex-code[full]",
    ],
    not_match = [
        "ccc status",
        "codegraph status .",
    ],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "branch"]],
    decision = "allow",
    justification = "Read-only git inspection is safe for routine repository analysis.",
    match = [
        "git status",
        "git diff --stat",
        "git log --oneline -5",
        "git show --stat HEAD",
        "git branch --show-current",
    ],
    not_match = [
        "git add .",
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", ["add", "commit", "push", "tag", "merge", "rebase"]],
    decision = "prompt",
    justification = "Git state changes require human awareness and task scope confirmation.",
    match = [
        "git add AGENTS.md",
        "git commit -m update-agent-config",
        "git push origin HEAD",
    ],
    not_match = [
        "git status",
        "git diff",
    ],
)

prefix_rule(
    pattern = ["git", ["reset", "clean", "checkout", "restore"]],
    decision = "forbidden",
    justification = "Potentially destructive git commands are blocked. Inspect status/diff and ask the user for an explicit recovery procedure instead.",
    match = [
        "git reset --hard",
        "git clean -fd",
        "git checkout -- src/example/generated-file.js",
        "git restore .",
    ],
    not_match = [
        "git status",
        "git show HEAD",
    ],
)

prefix_rule(
    pattern = [["npm", "pnpm", "yarn"], ["install", "add", "update", "upgrade", "dlx", "exec"]],
    decision = "prompt",
    justification = "Package installation or execution may alter the local environment or fetch third-party code.",
    match = [
        "npm install",
        "pnpm add lodash",
        "yarn dlx tool",
    ],
    not_match = [
        "npm test",
        "pnpm test",
    ],
)

prefix_rule(
    pattern = [["pip", "pip3"], "install"],
    decision = "prompt",
    justification = "Python package installation changes the local environment and may fetch third-party code.",
    match = [
        "pip install requests",
        "pip3 install -r requirements.txt",
    ],
    not_match = [
        "python -m unittest",
    ],
)

prefix_rule(
    pattern = [["python", "python3", "py"], "-m", "pip", "install"],
    decision = "prompt",
    justification = "Python package installation changes the local environment and may fetch third-party code.",
    match = [
        "python -m pip install requests",
        "py -m pip install -r requirements.txt",
    ],
    not_match = [
        "python -m pytest",
    ],
)

prefix_rule(
    pattern = [["terraform", "kubectl"], ["apply", "destroy", "delete", "create", "update", "put", "deploy"]],
    decision = "forbidden",
    justification = "Infrastructure and cloud mutation commands are blocked. Prepare a reviewed procedure for a human operator instead.",
    match = [
        "terraform apply",
        "terraform destroy",
        "kubectl delete pod example",
        "terraform destroy",
        "kubectl delete pod example",
    ],
    not_match = [
        "terraform version",
        "kubectl version --client",
    ],
)

prefix_rule(
    pattern = [["terraform", "kubectl", "aws", "az", "psql", "mysql", "sqlcmd", "mongo", "redis-cli"]],
    decision = "prompt",
    justification = "External infrastructure, cloud, and database CLIs require confirmation of target environment and authorization.",
    match = [
        "terraform plan",
        "kubectl get pods",
        "aws s3 ls",
        "psql -h prod-db",
    ],
    not_match = [
        "git status",
    ],
)

prefix_rule(
    pattern = [["rm", "del", "Remove-Item"], ["-rf", "-r", "/s", "-Recurse"]],
    decision = "forbidden",
    justification = "Recursive destructive filesystem commands are blocked. Use scoped, reviewed file edits instead.",
    match = [
        "rm -rf target",
        "del /s target",
        "Remove-Item -Recurse target",
    ],
    not_match = [
        "rg --files",
        "Get-ChildItem -Recurse",
    ],
)

prefix_rule(
    pattern = [["env", "printenv", "set"]],
    decision = "prompt",
    justification = "Environment dumps may expose credentials or tokens.",
    match = [
        "env",
        "printenv",
        "set",
    ],
    not_match = [
        "git status",
    ],
)

prefix_rule(
    pattern = [["curl", "wget", "Invoke-WebRequest", "iwr"]],
    decision = "prompt",
    justification = "Network downloads require confirmation and must not be piped to execution.",
    match = [
        "curl https://example.com/script.sh",
        "wget https://example.com/archive.tgz",
        "Invoke-WebRequest https://example.com",
    ],
    not_match = [
        "rg curl .ai",
    ],
)
