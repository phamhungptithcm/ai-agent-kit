{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": true,
  "cleanupPeriodDays": 30,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_AGENT_KIT_ADAPTER=claude node .ai/scripts/governed_action_gateway.mjs",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:AI_AGENT_KIT_ADAPTER='claude'; node .ai\\scripts\\governed_action_gateway.mjs\"",
            "timeout": 30,
            "statusMessage": "Authorizing governed action"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .ai/scripts/validate_implementation_approval.py --hook",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p='.ai\\scripts\\validate_implementation_approval.py'; if (Get-Command py -ErrorAction SilentlyContinue) { py -3 $p --hook } elseif (Get-Command python -ErrorAction SilentlyContinue) { python $p --hook } elseif (Get-Command uv -ErrorAction SilentlyContinue) { uv run --python 3.11 python $p --hook } else { exit 1 }\"",
            "timeout": 30,
            "statusMessage": "Checking tracked implementation approval"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .ai/scripts/enforce_command_policy.py --hook",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p='.ai\\scripts\\enforce_command_policy.py'; if (Get-Command py -ErrorAction SilentlyContinue) { py -3 $p --hook } elseif (Get-Command python -ErrorAction SilentlyContinue) { python $p --hook } elseif (Get-Command uv -ErrorAction SilentlyContinue) { uv run --python 3.11 python $p --hook } else { exit 1 }\"",
            "timeout": 30,
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/scripts/bootstrap-repository-intelligence.sh --hook",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .ai\\scripts\\bootstrap-repository-intelligence.ps1 -Hook",
            "timeout": 120,
            "statusMessage": "Checking repository intelligence gate"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/scripts/bootstrap-repository-intelligence.sh --hook",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .ai\\scripts\\bootstrap-repository-intelligence.ps1 -Hook",
            "timeout": 120,
            "statusMessage": "Checking repository intelligence gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AI_AGENT_KIT_ADAPTER=claude node .ai/scripts/final_task_report.mjs",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:AI_AGENT_KIT_ADAPTER='claude'; node .ai\\scripts\\final_task_report.mjs\"",
            "timeout": 30,
            "statusMessage": "Printing final task report"
          }
        ]
      }
    ]
  }
}
